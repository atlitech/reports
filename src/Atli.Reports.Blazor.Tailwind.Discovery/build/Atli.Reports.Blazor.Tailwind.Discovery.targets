    Project="Atli.Reports.Blazor.Tailwind.Discovery.Shared.targets"
    Condition="Exists('$(MSBuildThisFileDirectory)Atli.Reports.Blazor.Tailwind.Discovery.Shared.targets') and '$(_AtliTailwindDiscoveryImported)' != 'true'"
  />
