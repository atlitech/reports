{
  "ReportsEngine": {
    "ConversionTimeout": "00:01:00",
    "Browser": {
      "Headless": true,
      "NoSandbox": true,
      "DisableDevShmUsage": true,
      "CommandTimeout": "00:00:30",
      "WarmUpOnStartup": true
    },
    "Concurrency": {
      "MaxQueueLength": 100,
      "QueueTimeout": "00:00:30"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
