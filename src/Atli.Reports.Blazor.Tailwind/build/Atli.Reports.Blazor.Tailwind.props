<Project>
  <PropertyGroup>
    <AtliTailwindEnabled Condition="'$(AtliTailwindEnabled)' == ''">true</AtliTailwindEnabled>
    <EnableDefaultAtliTailwindItems Condition="'$(EnableDefaultAtliTailwindItems)' == ''"
      >true</EnableDefaultAtliTailwindItems>
    <AtliTailwindVersion Condition="'$(AtliTailwindVersion)' == ''">4.3.3</AtliTailwindVersion>
    <AtliTailwindMinify Condition="'$(AtliTailwindMinify)' == ''">true</AtliTailwindMinify>
    <AtliTailwindTimeoutSeconds Condition="'$(AtliTailwindTimeoutSeconds)' == ''"
      >120</AtliTailwindTimeoutSeconds>
  </PropertyGroup>
  <ItemGroup Condition="'$(AtliTailwindEnabled)' == 'true' and '$(EnableDefaultAtliTailwindItems)' == 'true'">
    <AtliTailwind
      Include="**/*.tailwind.css"
      Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder);bin/**;obj/**"
    />
  </ItemGroup>
</Project>
