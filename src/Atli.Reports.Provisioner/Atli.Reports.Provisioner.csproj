<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Creates, rolls out, and deletes per-customer renderers on Azure Container Apps Sandboxes. Runs off
    the request path, with rights the public API never holds; see README.md and
    docs/hosted-renderers.md.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>atli-reports-provisioner</AssemblyName>
    <RootNamespace>Atli.Reports.Provisioner</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      serve: the provisioning service's HTTP API on Kestrel. The framework also brings the
      configuration packages the commands use (appsettings.json and the Provisioner section).
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Atli.Reports.Hosting\Atli.Reports.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Atli.Reports.Provisioner.Tests" />
  </ItemGroup>
</Project>
