<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>Atli Reports Blazor</Title>
    <Description>Generate PDF reports from Blazor components. Map a component to an HTTP endpoint or render it from your own code. Formerly BlazorReports.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Atli.Reports.Blazor.Components\Atli.Reports.Blazor.Components.csproj" />
    <ProjectReference Include="..\Atli.Reports.Engine\Atli.Reports.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OneOf" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Atli.Reports.Blazor.Tests" />
  </ItemGroup>
</Project>
