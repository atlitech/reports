    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- Test names read as sentences (Maps_a_busy_server_to_busy); CA1707 only guards public API naming. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Atli.Reports.Blazor\Atli.Reports.Blazor.csproj" />
    <ProjectReference Include="..\..\src\Atli.Reports.Client\Atli.Reports.Client.csproj" />
    <ProjectReference Include="..\..\src\Atli.Reports.Server\Atli.Reports.Server.csproj" />
  </ItemGroup>
</Project>
